# ===========================================
# LLM Provider 설정 (ollama 또는 openai)
# ===========================================
LLM_PROVIDER=ollama

# ===========================================
# Ollama (로컬 LLM)
# ===========================================
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M

# ===========================================
# Google / Gemini API (deprecated - LLM_PROVIDER 사용)
# ===========================================
GOOGLE_API_KEY=your-google-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# ===========================================
# OpenAI API
# ===========================================
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# ===========================================
# Google Vision OCR API
# ===========================================
VISION_API_KEY=your-vision-api-key-here

# ===========================================
# Culture API (공공데이터)
# ===========================================
CULTURE_API_KEY=your-culture-api-key-here

# ===========================================
# AWS (S3)
# ===========================================
AWS_ACCESS_KEY_ID=your-aws-access-key-id-here
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key-here
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=your-s3-bucket-name-here

# ===========================================
# Veo (Video Generation)
# ===========================================
VEO_API_KEY=your-veo-api-key-here
VEO_MODEL=veo-3.0-generate-preview
VEO_OUTPUT_GCS_URI=gs://your-bucket/output

# ===========================================
# Redis (Celery Broker)
# ===========================================
REDIS_URL=redis://redis:6379/0

# ===========================================
# Qdrant (Vector DB)
# ===========================================
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_SCORE_THRESHOLD=0.7
